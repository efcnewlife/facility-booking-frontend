// Facility Booking staging on Cloudflare Workers Static Assets (EFC-313). Assets only: no Worker script runs.
// Deployed by CI (.github/workflows/ci.yml), or by hand with scripts/deploy-staging.sh from a kept CI build
// Operator setup, alternate-URL checks and rollback: newlife-infra docs/cloudflare-booking-staging.md
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "facility-booking-frontend-stg",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Only the custom domain serves this Worker: no *.workers.dev, Version or Preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "booking-dev.efcnewlife.com", "custom_domain": true }],
}
