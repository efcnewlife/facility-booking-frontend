VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_TIMEOUT=90000

VITE_APP_NAME=Facility Booking
VITE_APP_TITLE=Facility Booking
VITE_APP_VERSION=0.1.0

# Non-production: show Mock login collapsible on Sign in (requires backend MOCK_LOGIN_ENABLED)
VITE_SHOW_MOCK_LOGIN=true
# Optional default email for the mock login field
VITE_MOCK_LOGIN_EMAIL=qa@test.local
# Staging only: shared secret sent as X-Mock-Login-Secret (leave empty in local dev)
# VITE_MOCK_LOGIN_SECRET=

# Microsoft Entra ID (optional)
# VITE_AZURE_CLIENT_ID=
# VITE_AZURE_TENANT_ID=
# VITE_AZURE_REDIRECT_URI=http://localhost:5174

# Sentry (optional — telemetry stays off when unset; never commit a real DSN or any auth/upload token)
# Build mode maps to the telemetry environment: development → dev, staging → stg, production → prod.
# Other modes (including Vitest's "test") never initialize Sentry.
# VITE_SENTRY_DSN=
# dev: off unless "true". stg/prod: on when a DSN is set; "false" turns it off.
# VITE_SENTRY_ENABLED=
# Release version from the build pipeline, giving facility-booking-frontend@<version>:
# production → semantic version (e.g. 0.2.33), staging → short commit SHA (e.g. 5ba2c79).
# Ignored in dev (always facility-booking-frontend@local). A missing/invalid value keeps Sentry off.
# VITE_SENTRY_RELEASE_VERSION=
