# Staging build settings (pnpm build:stg), served at https://booking-dev.efcnewlife.com (EFC-313).
# Every VITE_ value is compiled into the public bundle: public values only, never a token or secret.
# CI adds VITE_SENTRY_RELEASE_VERSION (short commit) and VITE_SENTRY_DSN (repository variable) at build time.
# "dev" in the hostnames means staging, not local development.
# Vite also reads .env and .env.local in staging mode; values set here win over them.

VITE_API_BASE_URL=https://api-dev.efcnewlife.com

# Mock login stays off: it needs VITE_MOCK_LOGIN_SECRET, which this public bundle must never carry.
# Set explicitly so a local .env that turns it on cannot leak into a staging build.
VITE_SHOW_MOCK_LOGIN=false

# Entra registration "NewLife STG", shared with the Admin Portal (newlife-infra azure/entra/staging.json).
# The redirect URI must equal the registered SPA redirect exactly: no path, no trailing slash.
VITE_AZURE_CLIENT_ID=c0766d6c-3ce2-4f97-9052-a2c30c9e67c5
VITE_AZURE_TENANT_ID=1611ced1-d776-4134-acca-a77746e45623
VITE_AZURE_REDIRECT_URI=https://booking-dev.efcnewlife.com
